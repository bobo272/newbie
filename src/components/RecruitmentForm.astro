---

<form class="space-y-4 max-w-lg mx-auto">
  <div>
    <label for="name" class="block text-sm font-medium">姓名</label>
    <input id="name" type="text" class="w-full p-2 border rounded" required />
  </div>
  <div>
    <label for="email" class="block text-sm font-medium">邮箱</label>
    <input id="email" type="email" class="w-full p-2 border rounded" required />
  </div>
  <div>
    <label for="reason" class="block text-sm font-medium">加入理由</label>
    <textarea id="reason" class="w-full p-2 border rounded" rows="4"></textarea>
  </div>
  <button
    type="submit"
    class="px-4 py-2 bg-blue-500 text-white rounded hover:bg-blue600"
    >提交</button
  >
</form>
<script>
  document.querySelector("form").addEventListener("submit", async (e) => {
    e.preventDefault();
    alert("报名成功！我们会通过邮箱联系你。");
    // 后续可添加 API 调用逻辑
  });
</script>
